{
  "name": "dsh-plan-execute",
  "version": "0.1.0",
  "type": "module",
  "description": "「计划实施」三合一编排引擎：拷问决策(grill)→编译计划(compile)→执行验收(execute)，模型工具 plan_execute",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plan",
    "workflow",
    "grill",
    "execute"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leotangjc/plan-execute.git"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7"
  }
}